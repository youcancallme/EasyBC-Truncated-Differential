uint6[62] rc = {1,3,7,15,31,62,61,59,55,47,30,60,57,51,39,14,29,58,53,43,22,44,24,48,33,2,5,11,23,46,28,56,49,35,6,13,27,54,45,26,52,41,18,36,8,17,34,4,9,19,38,12,25,50,37,10,21,42,20,30,10,32};

r_fn uint4[16] round_function(uint8 r, uint4[8] key, uint4[16] input) {
    uint4[16] s_out;

    for (i from 0 to 15) {
        s_out[i] = s<input[i]>;
    }

    uint4[16] t_out = s_out;

    for (i from 0 to 7) {
        t_out[i] = s_out[i] ^ key[i];
    }

    uint4[16] p_out = p<t_out>;

    uint4[16] m_out;
    for (i from 0 to 3) {
        uint4[4] mtemp = {p_out[i], p_out[i + 4], p_out[i + 8], p_out[i + 12]};
        uint4[4] sm_out = M * mtemp;

        m_out[i] = sm_out[0];
        m_out[i + 4] = sm_out[1];
        m_out[i + 8] = sm_out[2];
        m_out[i + 12] = sm_out[3];
    }

    return m_out;
}

fn uint4[16] enc(uint4[256] key, uint4[16] r_plaintext){
    for (i from 1 to 32) {
        r_plaintext = round_function(i, View(key, (i - 1) * 8, i * 8 - 1), r_plaintext);
    }
    return r_plaintext;
}
